[Unit]
Description=easy-proxies proxy pool
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=easy-proxies
Group=easy-proxies
WorkingDirectory=/opt/easy-proxies
ExecStart=/opt/easy-proxies/easy-proxies -config /opt/easy-proxies/config.yaml
Restart=on-failure
RestartSec=5s
LimitNOFILE=1048576
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
